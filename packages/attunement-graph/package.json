{
  "name": "@muse/attunement-graph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./continuity": {
      "types": "./dist/continuity-projection.d.ts",
      "import": "./dist/continuity-projection.js"
    },
    "./continuity-changes": {
      "types": "./dist/continuity-change-query.d.ts",
      "import": "./dist/continuity-change-query.js"
    },
    "./continuity-observations": {
      "types": "./dist/continuity-observation.d.ts",
      "import": "./dist/continuity-observation.js"
    },
    "./continuity-capsules": {
      "types": "./dist/continuity-capsule-presentation.d.ts",
      "import": "./dist/continuity-capsule-presentation.js"
    },
    "./continuity-resume-runtime": {
      "types": "./dist/continuity-resume-runtime.d.ts",
      "import": "./dist/continuity-resume-runtime.js"
    }
  },
  "scripts": {
    "benchmark:continuity-changes": "pnpm build && node scripts/benchmark-continuity-changes.mjs",
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:continuity-capsules": "pnpm build && node scripts/verify-continuity-capsules.mjs",
    "verify:continuity-resume-runtime": "pnpm build && node scripts/verify-continuity-resume-runtime.mjs"
  },
  "dependencies": {
    "@muse/attunement": "workspace:*"
  }
}
