*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump

# Test artifacts
playwright-report/
test-results/
.vitest-attachments/
/reports/evals/

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# Agent session state (rules / harness / agents / skills ARE checked in)
.claude/scheduled_tasks.lock
# local per-machine permissions and paths — was covered only by the owner's global
# gitignore, so a fresh clone would have committed it
.claude/settings.local.json
# Codex session scratch, but .codex/config.toml is a committed project setting: it raises
# project_doc_max_bytes so AGENTS.md is not silently truncated on a fresh checkout.
.codex/*
!.codex/config.toml

# self-eval fitness log — local trend, rebuildable; not committed (avoids parallel-loop churn)
docs/self-eval-scoreboard.json

# generated work-status dashboard (rebuild with `pnpm status`) — local artifact, not committed
docs/status.html

# bench:local baseline — machine-specific timing, like the scoreboard; never committed
docs/benchmarks/bench-local-baseline.json

# local code-intelligence index + parallel-loop worktrees (never commit)
.codegraph/
.claude/worktrees/

# Regenerated each test-hardening loop iteration; machine-local dashboard data.
docs/test-report.json

# loop-v2 mock-corpus scratch — the loop freely generates throwaway mock data
# here and points MUSE_NOTES_DIR at it (never the real ~/.muse). The committed
# seed lives in fixtures/mock-corpus/.
.muse-dev/

# stray runner-agent artifacts
__pycache__/
*.pyc

docs/tool-selection-scoreboard.md
/.playwright-mcp/

# rebase/merge leftovers (several agents rebase on this machine)
*.orig
*.rej
